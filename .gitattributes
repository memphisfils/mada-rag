* text=auto

# Source code and metadata use stable LF line endings on every platform.
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# The snapshot SHA-256 is computed over the exact downloaded bytes.
data/raw/*.html -text
