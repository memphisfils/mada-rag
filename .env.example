# All settings are optional. The safe default disables LLM generation and does
# not require a secret.
MADA_RAG_GENERATION_PROVIDER=extractive
MADA_RAG_GENERATION_MODEL=
MADA_RAG_LLM_API_KEY=
MADA_RAG_LLM_BASE_URL=

# Versioned knowledge and rebuildable artifacts.
MADA_RAG_SNAPSHOT_DIR=data/raw
MADA_RAG_PROCESSED_DIR=data/processed
MADA_RAG_ARTIFACT_DIR=artifacts
MADA_RAG_EVALUATION_DIR=data/eval
MADA_RAG_PARSED_ARTICLE_PATH=data/processed/article.json
MADA_RAG_CHUNKS_PATH=data/processed/chunks.json
MADA_RAG_DENSE_INDEX_DIR=artifacts/indexes/dense

# Retrieval defaults.
MADA_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
MADA_RAG_RERANKER_ENABLED=false
MADA_RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MADA_RAG_DENSE_TOP_K=20
MADA_RAG_LEXICAL_TOP_K=20
MADA_RAG_FUSED_TOP_K=10
MADA_RAG_CONTEXT_TOP_K=5
MADA_RAG_RRF_K=60
MADA_RAG_DENSE_SCORE_THRESHOLD=0.45
MADA_RAG_MINIMUM_RETRIEVED_CHUNKS=1
MADA_RAG_EXTRACTIVE_MAX_CLAIMS=3
MADA_RAG_EXTRACTIVE_MAX_EXCERPT_CHARS=500

# API defaults.
MADA_RAG_API_HOST=127.0.0.1
MADA_RAG_API_PORT=8000
